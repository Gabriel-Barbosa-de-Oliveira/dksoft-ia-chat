{
  "name": "dksoft-ia-chat-api",
  "version": "0.0.1",
  "private": true,
  "description": "Backend do agente de chat DKSOFT (Fastify + LangGraph + SSE)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
