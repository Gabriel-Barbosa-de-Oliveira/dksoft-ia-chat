    "@langchain/openai": "^1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.15.1",
    "fastify": "^5.12.7",
    "langchain": "^1.6.0",
    "pdfmake": "^0.3.13",
    "write-excel-file": "^4.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.3.3",
