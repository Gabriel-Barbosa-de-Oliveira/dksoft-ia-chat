OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_FALLBACK=
API_TOKEN=
BASE_URL=https://dkapi.dksoft.com.br/api/v1
CHAT_ACCESS_KEY=
CHAT_CORS_ORIGINS=http://localhost:5173
CHAT_DB=./data/chat.db
PORT=3000
CHAT_TIMEOUT_MS=120000
CHAT_HISTORY_LIMIT=12
DKSOFT_MAX_CONCURRENCY=4
DKSOFT_MAX_PER_MINUTE=50
TOOL_RESULT_MAX_ROWS=40
CHAT_RATE_LIMIT_PER_MIN=30
MCP_ENTRY=../mcp/src/index.ts
# true quando há proxy reverso na frente (Fly.io): usa X-Forwarded-For no rate limit
TRUST_PROXY=false
# Exportação de arquivos e gráficos (spec 004). false restaura o comportamento do MVP
ARTIFACTS_ENABLED=true
RESULT_TTL_MS=3600000
RESULT_MAX_ROWS=20000
RESULT_STORE_MAX_MB=64
EXPORT_TTL_MS=1800000
EXPORT_MAX_ROWS=5000
EXPORT_TIMEOUT_MS=30000
EXPORT_MAX_CONCURRENCY=2
FILE_STORE_MAX_MB=96
EXPORT_RATE_LIMIT_PER_MIN=20
