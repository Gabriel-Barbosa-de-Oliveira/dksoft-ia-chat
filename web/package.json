{
  "name": "dksoft-ia-chat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src e2e",
    "test": "node --import tsx --import ./src/testing/register-css.ts --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --import tsx --test \"e2e/**/*.test.ts\"",
    "fake-api": "node --import tsx e2e/fake-api.ts"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
